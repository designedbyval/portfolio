---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CyclingWord from '../components/CyclingWord.astro';
import Label from '../components/Label.astro';
import { site } from '../data/site';
import photo from '../assets/about-photo.png';

// Figma component set "feel human" (55:541)
const words = [
  { text: 'feel human', color: 'var(--color-blue)' },
  { text: 'solve problems', color: 'var(--color-pink)' },
  { text: 'start with people', color: 'var(--color-green)' },
  { text: 'listen first', color: 'var(--color-yellow)' },
];

const experience = [
  { org: 'Google Developer Group on Campus @ PolyU', role: 'Social Media Lead' },
  { org: 'Rechips.co', role: 'UI/UX & Social Media Intern' },
  { org: 'Smooji Hong Kong', role: 'Marketing & Design Intern' },
  { org: 'Dress Green', role: 'Design Intern' },
  { org: 'Hong Kong Indonesian Student Association', role: 'Creative Design ExCom' },
];

const education = [
  { org: 'The Hong Kong Polytechnic University', role: 'BA (Hons) in Design (Interaction Design)' },
  { org: 'Politecnico di Milano', role: 'Fall Exchange 2026' },
];
---

<Base title="About" current="about" footerInvite="Feel free to reach out for collaborations or work.">
  <div class="about section">
    <header class="heading">
      <p class="mono">#02 About me</p>
      <h1 class="display">
        <span class="display-light">Hey!</span><br />
        I think design should.. <CyclingWord words={words} />
      </h1>
    </header>

    <div class="body">
      <section class="col col--exp" aria-labelledby="exp-title">
        <Label dot="blue" as="h2"><span id="exp-title">Experience</span></Label>
        <ul class="items" role="list">
          {
            experience.map((e) => (
              <li>
                <p class="org">{e.org}</p>
                <p>{e.role}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="col col--side">
        <section aria-labelledby="edu-title">
          <Label dot="pink" as="h2"><span id="edu-title">Education</span></Label>
          <ul class="items" role="list">
            {
              education.map((e) => (
                <li>
                  <p class="org">{e.org}</p>
                  <p>{e.role}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="resume-title">
          <Label dot="yellow" as="h2"><span id="resume-title">Resume</span></Label>
          <a class="link" href={site.resumeUrl} download>Click here to download my resume</a>
        </section>

        <section aria-labelledby="contacts-title">
          <Label dot="green" as="h2"><span id="contacts-title">Contacts</span></Label>
          <ul class="contacts" role="list">
            <li>
              <img src="/icons/mail-32.svg" alt="" width="32" height="32" />
              <a class="link" href={`mailto:${site.email}`}><span class="visually-hidden">Email: </span>{site.email}</a>
            </li>
            <li>
              <img src="/icons/phone.svg" alt="" width="33" height="32" />
              <a class="link" href={site.phoneHref}><span class="visually-hidden">Phone: </span>{site.phone}</a>
            </li>
            <li>
              <img src="/icons/linkedin-32.svg" alt="" width="32" height="32" />
              <a class="link" href={site.linkedinUrl} target="_blank" rel="noopener noreferrer"
                ><span class="visually-hidden">LinkedIn: </span>{site.linkedinHandle}<span class="visually-hidden"> (opens in a new tab)</span></a
              >
            </li>
          </ul>
        </section>
      </div>

      <figure class="photo">
        <Image
          src={photo}
          alt="Valencia smiling on the deck of a boat, with the waterfront and historic buildings behind her at golden hour"
          widths={[400, 800]}
          sizes="(max-width: 1023px) 100vw, 400px"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</Base>

<style>
  /* Figma About content: pt 32, pb 80, px 80, gap 48 */
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-4);
    padding-bottom: var(--space-10);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Figma Headline frame is 94px tall for two lines (vs 96 at Inter's normal leading) */
  .heading h1 {
    line-height: 47px;
  }

  @media (max-width: 599px) {
    .heading h1 {
      line-height: normal;
    }
  }

  /* Body: 344 | 440 | photo (fill, 512 tall), gap 48 */
  .body {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .col {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .col--exp {
    width: 344px;
    gap: var(--space-3);
  }

  .col--side {
    width: 440px;
    gap: var(--space-6);
  }

  .col--side > section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .items li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .org {
    font-weight: 500;
  }

  .col--exp .org {
    max-width: 240px;
  }

  .link {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .link:hover {
    text-decoration-thickness: 2px;
  }

  .contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contacts li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .contacts img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .photo {
    flex: 1 1 0;
    min-width: 0;
    height: 512px;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (max-width: 1279px) {
    .body {
      flex-wrap: wrap;
    }

    .photo {
      flex: 0 0 100%;
      order: -1;
      max-width: 480px;
      height: auto;
      aspect-ratio: 400 / 512;
    }
  }

  @media (max-width: 1023px) {
    .body {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: var(--space-6);
    }

    .col--exp,
    .col--side {
      width: 100%;
    }

    .photo {
      width: 100%;
    }
  }

  @media (max-width: 599px) {
    .about {
      padding-top: var(--space-3);
      padding-bottom: var(--space-8);
    }

    .photo {
      border-radius: var(--space-4);
    }
  }
</style>
