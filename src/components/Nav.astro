---
interface Props {
  current?: 'home' | 'work' | 'about';
}

const { current } = Astro.props;

const links = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'work', label: 'Work', href: '/#work' },
  { key: 'about', label: 'About', href: '/about' },
] as const;
---

<header class="nav">
  <nav class="pill" aria-label="Main">
    {
      links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* Figma: Nav (py 24) › Nav pill 640×56, px 88, 1px rgba(0,0,0,.3) border,
     radius 50, Glass effect + drop shadow 0 4 5.7 -3 rgba(0,0,0,.25) */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: var(--space-3) var(--gutter);
    pointer-events: none;
  }

  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 640px;
    max-width: 100%;
    height: 56px;
    padding-inline: var(--space-11);
    border: 1px solid var(--color-pill-border);
    border-radius: var(--radius-pill);
    background:
      linear-gradient(
        135deg,
        rgb(255 255 255 / 0.55) 0%,
        rgb(255 255 255 / 0.15) 45%,
        rgb(255 255 255 / 0) 60%,
        rgb(255 255 255 / 0.35) 100%
      ),
      rgb(250 244 231 / 0.6);
    -webkit-backdrop-filter: blur(4px) saturate(1.2);
    backdrop-filter: blur(4px) saturate(1.2);
    box-shadow:
      0 4px 5.7px -3px rgb(0 0 0 / 0.25),
      inset 0 1px 0 rgb(255 255 255 / 0.6);
    font-size: 20px;
    font-weight: 400;
  }

  .pill a {
    color: var(--color-ink-soft);
    text-decoration: none;
    padding: var(--space-1) 0;
    border-radius: var(--space-1);
  }

  .pill a:first-child {
    color: var(--color-ink);
  }

  .pill a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 1023px) {
    .pill {
      padding-inline: var(--space-5);
    }
  }

  @media (max-width: 599px) {
    .nav {
      padding-block: var(--space-2);
    }

    .pill {
      height: 48px;
      padding-inline: var(--space-3);
      font-size: 16px;
    }
  }
</style>
